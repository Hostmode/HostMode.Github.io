{
  "rules": {
    "partygames": {
      "owner": {
        ".read": true,
        ".write": "!data.exists() && auth != null && newData.val() === auth.uid"
      },
      "admin": {
        ".read": true,
        ".write": "auth != null && auth.uid === root.child('partygames/owner').val()"
      },
      "index": {
        ".read": "auth != null && (auth.uid === root.child('partygames/owner').val() || root.child('partygames/staff/' + auth.uid).exists())",
        "$ev": {
          ".read": true,
          ".write": "!data.exists() || $ev.endsWith('-P') || (auth != null && (auth.uid === root.child('partygames/owner').val() || auth.uid === data.child('planner').val()))"
        }
      },
      "invites": {
        ".read": "auth != null && auth.uid === root.child('partygames/owner').val()",
        ".write": "auth != null && auth.uid === root.child('partygames/owner').val()",
        "$code": {
          ".read": true,
          ".write": "data.exists() && newData.exists() && data.child('active').val() === true && !data.child('event').exists() && newData.child('used').val() === 1"
        }
      },
      "pinvites": {
        ".read": "auth != null && auth.uid === root.child('partygames/owner').val()",
        ".write": "auth != null && auth.uid === root.child('partygames/owner').val()",
        "$code": {
          ".read": true,
          ".write": "auth != null && data.exists() && !data.child('by').exists() && data.child('active').val() === true && newData.child('by').val() === auth.uid"
        }
      },
      "plist": {
        ".read": "auth != null && (auth.uid === root.child('partygames/owner').val() || root.child('partygames/staff/' + auth.uid).exists())",
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === root.child('partygames/owner').val())"
        }
      },
      "leads": {
        ".read": "auth != null && auth.uid === root.child('partygames/owner').val()",
        "$id": {
          ".write": "!data.exists() || (auth != null && auth.uid === root.child('partygames/owner').val())"
        }
      },
      "planners": {
        ".read": "auth != null && (auth.uid === root.child('partygames/owner').val() || root.child('partygames/staff/' + auth.uid).exists())",
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || auth.uid === root.child('partygames/owner').val() || root.child('partygames/staff/' + auth.uid).exists())",
          ".write": "auth != null && (auth.uid === root.child('partygames/owner').val() || (auth.uid === $uid && newData.child('profile').exists()))",
          "profile": {
            ".validate": "newData.child('name').isString() && (root.child('partygames/pinvites/' + newData.child('code').val() + '/by').val() === $uid || newData.child('code').val() === 'OWNER' && $uid === root.child('partygames/owner').val())"
          },
          "brand": {
            ".read": true
          },
          "dayOf": {
            ".read": true
          },
          "tv": {
            "$ev": {
              ".read": true
            }
          },
          "clients": {
            "$id": {
              ".read": true,
              ".write": "data.exists() && newData.exists()"
            }
          },
          "clientTasks": {
            "$id": {
              ".read": true,
              ".write": "root.child('partygames/planners/' + $uid + '/clients/' + $id).exists()"
            }
          },
          "clientMsgs": {
            "$id": {
              ".read": true,
              ".write": "root.child('partygames/planners/' + $uid + '/clients/' + $id).exists()"
            }
          },
          "clientFiles": {
            "$id": {
              ".read": true,
              ".write": "root.child('partygames/planners/' + $uid + '/clients/' + $id).exists()"
            }
          },
          "clientBlobs": {
            "$id": {
              ".read": true,
              ".write": "root.child('partygames/planners/' + $uid + '/clients/' + $id).exists()"
            }
          },
          "clientApprovals": {
            "$id": {
              ".read": true,
              ".write": "root.child('partygames/planners/' + $uid + '/clients/' + $id).exists()"
            }
          },
          "clientPayments": {
            "$id": {
              ".read": true,
              ".write": "root.child('partygames/planners/' + $uid + '/clients/' + $id).exists()"
            }
          },
          "clientDates": {
            "$id": {
              ".read": true,
              ".write": "root.child('partygames/planners/' + $uid + '/clients/' + $id).exists()"
            }
          },
          "clientVendors": {
            "$id": {
              ".read": true,
              ".write": "root.child('partygames/planners/' + $uid + '/clients/' + $id).exists()"
            }
          },
          "mates": {
            "$id": {
              ".read": true,
              ".write": "data.exists() && newData.exists()"
            }
          },
          "mateTasks": {
            "$id": {
              ".read": true,
              ".write": "root.child('partygames/planners/' + $uid + '/mates/' + $id).exists()"
            }
          },
          "feedback": {
            "$key": {
              "$id": {
                ".write": "!data.exists() && root.child('partygames/planners/' + $uid + '/profile').exists()"
              }
            }
          },
          "clientInvoices": {
            "$id": {
              ".read": true
            }
          },
          "inquiries": {
            "$id": {
              ".write": "!data.exists() && newData.exists() && root.child('partygames/planners/' + $uid + '/profile').exists()",
              ".validate": "newData.hasChildren(['name','email','t']) && newData.child('name').isString() && newData.child('name').val().length <= 80 && newData.child('email').isString() && newData.child('email').val().length <= 120 && newData.child('t').isNumber() && (!newData.child('msg').exists() || (newData.child('msg').isString() && newData.child('msg').val().length <= 2000))"
            }
          },
          "showcase": {
            ".read": true
          },
          "showImg": {
            ".read": true
          }
        }
      },
      "clients": {
        ".read": "auth != null && auth.uid === root.child('partygames/owner').val()",
        ".write": "auth != null && auth.uid === root.child('partygames/owner').val()"
      },
      "clientTasks": {
        ".read": "auth != null && auth.uid === root.child('partygames/owner').val()",
        ".write": "auth != null && auth.uid === root.child('partygames/owner').val()"
      },
      "clientMsgs": {
        ".read": "auth != null && auth.uid === root.child('partygames/owner').val()",
        ".write": "auth != null && auth.uid === root.child('partygames/owner').val()"
      },
      "clientFiles": {
        ".read": "auth != null && auth.uid === root.child('partygames/owner').val()",
        ".write": "auth != null && auth.uid === root.child('partygames/owner').val()"
      },
      "clientBlobs": {
        ".read": "auth != null && auth.uid === root.child('partygames/owner').val()",
        ".write": "auth != null && auth.uid === root.child('partygames/owner').val()"
      },
      "clientTemplates": {
        ".read": "auth != null && auth.uid === root.child('partygames/owner').val()",
        ".write": "auth != null && auth.uid === root.child('partygames/owner').val()"
      },
      "clientApprovals": {
        ".read": "auth != null && auth.uid === root.child('partygames/owner').val()",
        ".write": "auth != null && auth.uid === root.child('partygames/owner').val()"
      },
      "clientPayments": {
        ".read": "auth != null && auth.uid === root.child('partygames/owner').val()",
        ".write": "auth != null && auth.uid === root.child('partygames/owner').val()"
      },
      "clientDates": {
        ".read": "auth != null && auth.uid === root.child('partygames/owner').val()",
        ".write": "auth != null && auth.uid === root.child('partygames/owner').val()"
      },
      "clientVendors": {
        ".read": "auth != null && auth.uid === root.child('partygames/owner').val()",
        ".write": "auth != null && auth.uid === root.child('partygames/owner').val()"
      },
      "mates": {
        ".read": "auth != null && auth.uid === root.child('partygames/owner').val()",
        ".write": "auth != null && auth.uid === root.child('partygames/owner').val()"
      },
      "mateTasks": {
        ".read": "auth != null && auth.uid === root.child('partygames/owner').val()",
        ".write": "auth != null && auth.uid === root.child('partygames/owner').val()"
      },
      "brand": {
        ".read": "auth != null && auth.uid === root.child('partygames/owner').val()",
        ".write": "auth != null && auth.uid === root.child('partygames/owner').val()"
      },
      "dayOf": {
        ".read": "auth != null && auth.uid === root.child('partygames/owner').val()",
        ".write": "auth != null && auth.uid === root.child('partygames/owner').val()"
      },
      "feedback": {
        ".read": "auth != null && auth.uid === root.child('partygames/owner').val()",
        ".write": "auth != null && auth.uid === root.child('partygames/owner').val()"
      },
      "clientInvoices": {
        ".read": "auth != null && auth.uid === root.child('partygames/owner').val()",
        ".write": "auth != null && auth.uid === root.child('partygames/owner').val()"
      },
      "packages": {
        ".read": "auth != null && auth.uid === root.child('partygames/owner').val()",
        ".write": "auth != null && auth.uid === root.child('partygames/owner').val()"
      },
      "events": {
        "$ev": {
          ".read": true,
          ".write": "newData.exists() || $ev.endsWith('-P') || (auth != null && (auth.uid === root.child('partygames/owner').val() || auth.uid === data.child('meta/planner').val()))"
        }
      },
      "themes": {
        ".read": true,
        "$id": {
          ".write": "!data.exists() || (auth != null && auth.uid === root.child('partygames/owner').val())"
        }
      },
      "library": {
        ".read": true,
        "$id": {
          ".write": true
        }
      },
      "archives": {
        ".read": "auth != null && auth.uid === root.child('partygames/owner').val()",
        ".write": "auth != null && auth.uid === root.child('partygames/owner').val()",
        "$code": {
          "$t": {
            ".write": "!data.exists() || (auth != null && auth.uid === root.child('partygames/owner').val())"
          }
        }
      },
      "tv": {
        ".write": "auth != null && auth.uid === root.child('partygames/owner').val()",
        "$ev": {
          ".read": true
        }
      },
      "imMaps": {
        ".read": "auth != null && auth.uid === root.child('partygames/owner').val()",
        ".write": "auth != null && auth.uid === root.child('partygames/owner').val()"
      },
      "imports": {
        ".read": "auth != null && auth.uid === root.child('partygames/owner').val()",
        ".write": "auth != null && auth.uid === root.child('partygames/owner').val()"
      },
      "invSettings": {
        ".read": "auth != null && auth.uid === root.child('partygames/owner').val()",
        ".write": "auth != null && auth.uid === root.child('partygames/owner').val()"
      },
      "profile": {
        ".read": "auth != null && auth.uid === root.child('partygames/owner').val()",
        ".write": "auth != null && auth.uid === root.child('partygames/owner').val()"
      },
      "staff": {
        ".read": "auth != null && (auth.uid === root.child('partygames/owner').val() || root.child('partygames/staff/' + auth.uid).exists())",
        ".write": "auth != null && auth.uid === root.child('partygames/owner').val()",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (data.exists() ? (newData.exists() && newData.child('role').val() === data.child('role').val()) : (newData.child('role').val() === 'support' && root.child('partygames/sinvites/' + newData.child('code').val() + '/by').val() === $uid))",
          ".validate": "newData.hasChildren(['name','role']) && newData.child('name').isString() && newData.child('name').val().length <= 40"
        }
      },
      "sinvites": {
        ".read": "auth != null && auth.uid === root.child('partygames/owner').val()",
        ".write": "auth != null && auth.uid === root.child('partygames/owner').val()",
        "$code": {
          ".read": true,
          ".write": "auth != null && data.exists() && !data.child('by').exists() && data.child('active').val() === true && newData.child('by').val() === auth.uid"
        }
      },
      "tickets": {
        ".read": "auth != null && (auth.uid === root.child('partygames/owner').val() || root.child('partygames/staff/' + auth.uid).exists())",
        "$id": {
          ".read": true,
          ".write": "(!data.exists() && newData.child('status').val() === 'new') || (auth != null && (auth.uid === root.child('partygames/owner').val() || (root.child('partygames/staff/' + auth.uid).exists() && data.exists() && newData.exists())))",
          ".validate": "newData.hasChildren(['msg','t','status']) && newData.child('msg').isString() && newData.child('msg').val().length <= 2000 && newData.child('t').isNumber()",
          "last": {
            ".write": "data.parent().exists()",
            ".validate": "newData.isNumber()"
          },
          "lastFrom": {
            ".write": "data.parent().exists()",
            ".validate": "newData.val() === 'reporter' || newData.val() === 'staff'"
          }
        }
      },
      "ticketReplies": {
        "$id": {
          ".read": true,
          "$r": {
            ".write": "!data.exists() && root.child('partygames/tickets/' + $id).exists() && (newData.child('from').val() === 'reporter' || (auth != null && (auth.uid === root.child('partygames/owner').val() || root.child('partygames/staff/' + auth.uid).exists())))",
            ".validate": "newData.hasChildren(['text','t','from']) && newData.child('text').isString() && newData.child('text').val().length <= 2000 && (newData.child('from').val() === 'reporter' || newData.child('from').val() === 'staff')"
          }
        }
      },
      "ticketNotes": {
        ".read": "auth != null && (auth.uid === root.child('partygames/owner').val() || root.child('partygames/staff/' + auth.uid).exists())",
        "$id": {
          ".write": "auth != null && (auth.uid === root.child('partygames/owner').val() || (root.child('partygames/staff/' + auth.uid).exists() && newData.exists()))"
        }
      }
    },
    "menu": {
      ".read": true,
      ".write": true
    },
    "orders": {
      ".read": true,
      "$id": {
        ".write": true
      }
    }
  }
}
